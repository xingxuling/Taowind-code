{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taowind.company/schemas/taowind-code-changeset-v0.3.json",
  "title": "Taowind Code Transactional Changeset v0.3",
  "type": "object",
  "required": ["id", "protocol", "runId", "source", "status", "createdAt", "updatedAt", "changes", "applyReceipt", "rollbackReceipt"],
  "properties": {
    "id": {"type": "string", "pattern": "^cs-[a-f0-9]+$"},
    "protocol": {"const": "taowind-code.changeset.v0.3"},
    "runId": {"type": "string"},
    "source": {"type": "string"},
    "status": {"enum": ["STAGED", "APPLIED", "ROLLED_BACK"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": ["op", "path", "before", "after"],
        "properties": {
          "op": {"enum": ["write", "delete"]},
          "path": {"type": "string"},
          "before": {"$ref": "#/$defs/beforeImage"},
          "after": {"$ref": "#/$defs/afterImage"}
        }
      }
    },
    "applyReceipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/applyReceipt"}]},
    "rollbackReceipt": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/rollbackReceipt"}]}
  },
  "$defs": {
    "nullableHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "nullableString": {"type": ["string", "null"]},
    "nullableInteger": {"type": ["integer", "null"]},
    "beforeImage": {
      "type": "object",
      "required": ["exists", "type", "sha256", "size", "identity", "mode", "contentBase64"],
      "properties": {
        "exists": {"type": "boolean"},
        "type": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/nullableHash"},
        "size": {"type": "integer", "minimum": 0},
        "identity": {"$ref": "#/$defs/nullableString"},
        "mode": {"$ref": "#/$defs/nullableInteger"},
        "contentBase64": {"$ref": "#/$defs/nullableString"}
      }
    },
    "afterImage": {
      "type": "object",
      "required": ["sha256", "size", "contentBase64"],
      "properties": {
        "sha256": {"$ref": "#/$defs/nullableHash"},
        "size": {"type": "integer", "minimum": 0},
        "contentBase64": {"$ref": "#/$defs/nullableString"}
      }
    },
    "applyFile": {
      "type": "object",
      "required": ["path", "op", "sha256", "exists", "identity", "mode"],
      "properties": {
        "path": {"type": "string"},
        "op": {"enum": ["write", "delete"]},
        "sha256": {"$ref": "#/$defs/nullableHash"},
        "exists": {"type": "boolean"},
        "identity": {"$ref": "#/$defs/nullableString"},
        "mode": {"$ref": "#/$defs/nullableInteger"}
      }
    },
    "rollbackFile": {
      "type": "object",
      "required": ["path", "exists", "sha256", "identity", "mode"],
      "properties": {
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "sha256": {"$ref": "#/$defs/nullableHash"},
        "identity": {"$ref": "#/$defs/nullableString"},
        "mode": {"$ref": "#/$defs/nullableInteger"}
      }
    },
    "applyReceipt": {
      "type": "object",
      "required": ["at", "files", "receiptSha256"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "files": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/applyFile"}},
        "receiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "rollbackReceipt": {
      "type": "object",
      "required": ["at", "files", "receiptSha256"],
      "properties": {
        "at": {"type": "string", "format": "date-time"},
        "files": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/rollbackFile"}},
        "receiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
