{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://taowind.company/schemas/taowind-code-rcl-authority-receipt-v0.1.json",
  "title":"Taowind Code RCL Authority Receipt v0.1",
  "type":"object",
  "required":["id","protocol","at","requestId","action","approvalMode","workspace","allowed","reason","policyDigest","materializedDigest","context","rcl","metadata"],
  "properties":{
    "id":{"type":"string","pattern":"^auth-[a-z0-9]+-[a-f0-9]{10}$"},
    "protocol":{"const":"taowind-code.rcl-authority-receipt.v0.1"},
    "at":{"type":"string","format":"date-time"},
    "requestId":{"type":"string","minLength":1},
    "action":{"enum":["workspace_write","shell_execute","changeset_apply","changeset_rollback","validation_execute","git_commit","mission_advance","external_side_effect"]},
    "approvalMode":{"enum":["read_only","workspace","full_access"]},
    "workspace":{"type":["string","null"]},
    "allowed":{"type":"boolean"},
    "reason":{"type":"string","minLength":1},
    "policyDigest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "materializedDigest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "context":{"anyOf":[{"type":"null"},{"type":"object","required":["workspace_write","shell_execute","changeset_apply","validation_execute","git_delivery","mission_advance","workspace_boundary","explicit_approval"],"properties":{"workspace_write":{"type":"boolean"},"shell_execute":{"type":"boolean"},"changeset_apply":{"type":"boolean"},"validation_execute":{"type":"boolean"},"git_delivery":{"type":"boolean"},"mission_advance":{"type":"boolean"},"workspace_boundary":{"type":"boolean"},"explicit_approval":{"type":"boolean"}}}]},
    "rcl":{"anyOf":[{"type":"object","required":["error","message"],"properties":{"error":{"type":"string","minLength":1},"message":{"type":"string"}}},{"type":"object","required":["stateRoot","rule","actor","authority","witnesses","historyLength"],"properties":{"witnesses":{"type":"array"},"historyLength":{"type":"integer","minimum":0}}}]},
    "metadata":{"type":"object"}
  },
  "allOf":[
    {"if":{"properties":{"approvalMode":{"const":"read_only"}},"required":["approvalMode"]},"then":{"properties":{"context":{"anyOf":[{"type":"null"},{"type":"object","properties":{"workspace_write":{"const":false},"shell_execute":{"const":false},"changeset_apply":{"const":false},"validation_execute":{"const":false},"git_delivery":{"const":false},"mission_advance":{"const":true}}}]}}}},
    {"if":{"properties":{"approvalMode":{"const":"workspace"}},"required":["approvalMode"]},"then":{"properties":{"context":{"anyOf":[{"type":"null"},{"type":"object","properties":{"workspace_write":{"const":true},"shell_execute":{"const":true},"changeset_apply":{"const":true},"validation_execute":{"const":true},"git_delivery":{"const":false},"mission_advance":{"const":true}}}]}}}},
    {"if":{"properties":{"approvalMode":{"const":"full_access"}},"required":["approvalMode"]},"then":{"properties":{"context":{"anyOf":[{"type":"null"},{"type":"object","properties":{"workspace_write":{"const":true},"shell_execute":{"const":true},"changeset_apply":{"const":true},"validation_execute":{"const":true},"git_delivery":{"const":true},"mission_advance":{"const":true}}}]}}}},
    {"if":{"properties":{"policyDigest":{"type":"string"}},"required":["policyDigest"]},"then":{"properties":{"context":{"type":"object"}}}},
    {"if":{"properties":{"context":{"type":"object"}},"required":["context"]},"then":{"properties":{"policyDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    {"if":{"properties":{"materializedDigest":{"type":"string"}},"required":["materializedDigest"]},"then":{"properties":{"context":{"type":"object"},"policyDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    {"if":{"properties":{"rcl":{"type":"object","required":["stateRoot","rule","actor","authority","witnesses","historyLength"]}},"required":["rcl"]},"then":{"properties":{"context":{"type":"object"},"policyDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"materializedDigest":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}},
    {"if":{"properties":{"allowed":{"const":false},"rcl":{"type":"object","required":["stateRoot","rule","actor","authority","witnesses","historyLength"]}},"required":["allowed","rcl"]},"then":{"properties":{"reason":{"const":"RCL_TRANSITION_NOT_REALIZED"}}}},
    {"if":{"properties":{"rcl":{"type":"object","required":["error"]}},"required":["rcl"]},"then":{"properties":{"allowed":{"const":false}}}},
    {"if":{"properties":{"allowed":{"const":true}},"required":["allowed"]},"then":{"properties":{"reason":{"const":"RCL_AUTHORITY_GRANTED"},"rcl":{"type":"object","required":["stateRoot","rule","actor","authority","witnesses","historyLength"],"properties":{"authority":{"type":"object","required":["needs"],"properties":{"needs":{"type":"array","minItems":1}}},"historyLength":{"type":"integer","minimum":1}}}}}},
    {"if":{"properties":{"allowed":{"const":true},"action":{"const":"workspace_write"}},"required":["allowed","action"]},"then":{"properties":{"rcl":{"type":"object","properties":{"rule":{"const":"authorize_workspace_write"}},"required":["rule"]}}}},
    {"if":{"properties":{"allowed":{"const":true},"action":{"const":"shell_execute"}},"required":["allowed","action"]},"then":{"properties":{"rcl":{"type":"object","properties":{"rule":{"const":"authorize_shell_execute"}},"required":["rule"]}}}},
    {"if":{"properties":{"allowed":{"const":true},"action":{"const":"changeset_apply"}},"required":["allowed","action"]},"then":{"properties":{"rcl":{"type":"object","properties":{"rule":{"const":"authorize_changeset_apply"}},"required":["rule"]}}}},
    {"if":{"properties":{"allowed":{"const":true},"action":{"const":"changeset_rollback"}},"required":["allowed","action"]},"then":{"properties":{"rcl":{"type":"object","properties":{"rule":{"const":"authorize_changeset_rollback"}},"required":["rule"]}}}},
    {"if":{"properties":{"allowed":{"const":true},"action":{"const":"validation_execute"}},"required":["allowed","action"]},"then":{"properties":{"rcl":{"type":"object","properties":{"rule":{"const":"authorize_validation_execute"}},"required":["rule"]}}}},
    {"if":{"properties":{"allowed":{"const":true},"action":{"const":"git_commit"}},"required":["allowed","action"]},"then":{"properties":{"rcl":{"type":"object","properties":{"rule":{"const":"authorize_git_commit"}},"required":["rule"]}}}},
    {"if":{"properties":{"allowed":{"const":true},"action":{"const":"mission_advance"}},"required":["allowed","action"]},"then":{"properties":{"rcl":{"type":"object","properties":{"rule":{"const":"authorize_mission_advance"}},"required":["rule"]}}}},
    {"if":{"properties":{"allowed":{"const":true},"action":{"const":"external_side_effect"}},"required":["allowed","action"]},"then":{"properties":{"rcl":{"type":"object","properties":{"rule":{"const":"authorize_external_side_effect"}},"required":["rule"]}}}}
  ]
}
