{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://taowind.company/schemas/taowind-code-autonomous-mission-v0.1.json",
  "title":"Taowind Code Autonomous Mission v0.1",
  "type":"object",
  "required":["id","protocol","rootGoal","status","cycle","config","createdAt","updatedAt","cycles","events","evidence"],
  "properties":{
    "id":{"type":"string","pattern":"^mission-[A-Za-z0-9-]+$"},
    "protocol":{"const":"taowind-code.autonomous-mission.v0.1"},
    "rootGoal":{"type":"string","minLength":1,"pattern":"\\S"},
    "nextGoal":{"type":"string","minLength":1,"pattern":"\\S"},
    "status":{"enum":["ACTIVE","WAITING_PROVIDER","WAITING_APPROVAL","GOAL_CLOSED","BUDGET_EXHAUSTED","BLOCKED","FAILED"]},
    "cycle":{"type":"integer","minimum":0},
    "currentRunId":{"anyOf":[{"type":"string","pattern":"^run-[A-Za-z0-9-]+$"},{"type":"null"}]},
    "config":{"type":"object","required":["maxCycles","maxRepairs","closureThreshold","autoCommit"],"properties":{"maxCycles":{"type":"number","minimum":1,"maximum":64},"maxRepairs":{"type":"number","minimum":0,"maximum":8},"closureThreshold":{"type":"number","minimum":0.5,"maximum":1},"autoCommit":{"type":"boolean"}}},
    "createdAt":{"type":"string","minLength":1},
    "updatedAt":{"type":"string","minLength":1},
    "cycles":{"type":"array","items":{"type":"object","required":["index","runId","goal","mode","status","closedAt","assessment"],"properties":{"index":{"type":"integer","minimum":1},"runId":{"type":"string","pattern":"^run-[A-Za-z0-9-]+$"},"goal":{"type":"string","minLength":1,"pattern":"\\S"},"mode":{"enum":["NORTH_STAR","NORTH_STAR_BURST","WHOLE_ARTIFACT","DEEP_DEVELOPMENT"]},"status":{"enum":["READY_FOR_DELIVERY","DELIVERED_LOCAL"]},"closedAt":{"type":"string","minLength":1},"assessment":{}}}},
    "events":{"type":"array","items":{"type":"object","required":["seq","at","type","data"],"properties":{"seq":{"type":"integer","minimum":1},"at":{"type":"string","minLength":1},"type":{"type":"string","minLength":1}}}},
    "evidence":{"type":"array","items":{"type":"object","required":["id","at"],"properties":{"id":{"type":"string","pattern":"^mev-[a-f0-9]{12}$"},"at":{"type":"string","minLength":1}}}},
    "closure":{"anyOf":[{"type":"object","properties":{"runId":{"type":"string","pattern":"^run-[A-Za-z0-9-]+$"}}},{"type":"null"}]},
    "blocker":{"type":["string","null"]}
  }
}
