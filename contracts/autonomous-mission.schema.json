{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://taowind.company/schemas/taowind-code-autonomous-mission-v0.1.json",
  "title":"Taowind Code Autonomous Mission v0.1",
  "type":"object",
  "required":["id","protocol","rootGoal","status","cycle","config","cycles","events","evidence"],
  "properties":{
    "id":{"type":"string","pattern":"^mission-[A-Za-z0-9-]+$"},
    "protocol":{"const":"taowind-code.autonomous-mission.v0.1"},
    "rootGoal":{"type":"string","minLength":1,"pattern":"\\S"},
    "nextGoal":{"type":"string","minLength":1,"pattern":"\\S"},
    "status":{"enum":["ACTIVE","WAITING_PROVIDER","WAITING_APPROVAL","GOAL_CLOSED","BUDGET_EXHAUSTED","BLOCKED","FAILED"]},
    "cycle":{"type":"integer","minimum":0},
    "currentRunId":{"anyOf":[{"type":"string","pattern":"^run-[A-Za-z0-9-]+$"},{"type":"null"}]},
    "config":{"type":"object","required":["maxCycles","maxRepairs","closureThreshold","autoCommit"],"properties":{"maxCycles":{"type":"number","minimum":1,"maximum":64},"maxRepairs":{"type":"number","minimum":0,"maximum":8},"closureThreshold":{"type":"number","minimum":0.5,"maximum":1},"autoCommit":{"type":"boolean"}}},
    "cycles":{"type":"array","items":{"type":"object","required":["runId"],"properties":{"runId":{"type":"string","pattern":"^run-[A-Za-z0-9-]+$"}}}},
    "events":{"type":"array"},
    "evidence":{"type":"array"},
    "closure":{"anyOf":[{"type":"object","properties":{"runId":{"type":"string","pattern":"^run-[A-Za-z0-9-]+$"}}},{"type":"null"}]},
    "blocker":{"type":["string","null"]}
  }
}
