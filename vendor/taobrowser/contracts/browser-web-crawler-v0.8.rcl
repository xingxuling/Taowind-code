reality TaoBrowserWebCrawlerV08 {
  facet world.browser_navigation_unrestricted : Truth = true
  facet world.seed_frontier : Truth = true
  facet world.robots_and_sitemap : Truth = true
  facet world.per_host_politeness : Truth = true
  facet world.canonical_dedup : Truth = true
